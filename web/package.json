{
  "name": "freebutton-web-editor",
  "version": "2.0.0",
  "description": "Browser-based JavaScript IDE for FreeButton development",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "generate-stdlib": "bash -c 'cd .. && ./tools/scripts/generate_stdlib_json.sh'",
    "generate-types": "node scripts/generate-types.js",
    "generate-autocomplete": "node scripts/generate-autocomplete.js",
    "prebuild": "npm run generate-stdlib && npm run generate-types && npm run generate-autocomplete",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "freebutton",
    "editor",
    "codemirror",
    "javascript",
    "wasm",
    "lit"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/language": "^6.12.1",
    "@codemirror/lint": "^6.9.4",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.14",
    "@fsegurai/codemirror-theme-github-dark": "^6.2.3",
    "acorn": "^8.15.0",
    "codemirror": "^6.0.2",
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "happy-dom": "^20.6.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.16"
  }
}
