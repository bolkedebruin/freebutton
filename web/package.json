{
  "name": "freebutton-web-editor",
  "version": "2.0.0",
  "description": "Browser-based JavaScript IDE for FreeButton development",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "generate-stdlib": "bash -c 'cd .. && ./tools/scripts/generate_stdlib_json.sh'",
    "generate-types": "node scripts/generate-types.js",
    "generate-autocomplete": "node scripts/generate-autocomplete.js",
    "prebuild": "npm run generate-stdlib && npm run generate-types && npm run generate-autocomplete",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "freebutton",
    "editor",
    "codemirror",
    "javascript",
    "wasm",
    "lit"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "happy-dom": "^20.6.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.16"
  }
}
